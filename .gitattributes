# ─────────────────────────────────────────────────────────────
# Normalización de finales de línea y definición de binarios
# ─────────────────────────────────────────────────────────────
* text=auto eol=lf

# Scripts de Windows
*.ps1 text eol=crlf
*.bat text eol=crlf

# Archivos binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.parquet binary
*.spacy binary
*.zip binary
*.tar.gz binary
*.mp3 binary
*.wav binary

# Diagramas
*.excalidraw text eol=lf

# Juicios de relevancia: se versionan byte a byte para que su SHA-256 coincida con FUENTE.md
juicios_de_relevancia.csv -text
